# ---- 密钥与环境变量（绝不入库）----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 运行时数据 ----
data/
temp_audio/
*.db
*.sqlite3

